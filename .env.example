# LLM keys (free tiers)
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Clio Manage (read-only access to the Sapini matter)
# Create an app at https://app.clio.com/settings/developer_applications
# Redirect URI: http://localhost:8000/auth/clio/callback
# Either paste an access token directly, or fill id/secret and visit http://localhost:8000/auth/clio/login
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_ACCESS_TOKEN=
CLIO_REFRESH_TOKEN=
CLIO_REGION_BASE_URL=https://app.clio.com
CLIO_REDIRECT_URI=http://localhost:8000/auth/clio/callback
# Which matter to read (matched against display number / description)
CLIO_MATTER_QUERY=Sapini
# live = read Clio API (default). mirror = read the local Sapini JSON mirror (offline dev only, labeled in the UI)
CLIO_SOURCE=live
SAPINI_MIRROR_PATH=../Sapini Case Materials/sapini-clio-data.json

# App
FIRM_NAME=
DATABASE_URL=sqlite:///./clearcase.db
SIGNING_KEY_PATH=./secrets/firm_ed25519.pem
PUBLIC_BASE_URL=http://localhost:5173

# Optional email notifications (Resend free tier). Blank = notifications stay in-app only.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=

# Hosting (leave empty for local use)
APP_PASSWORD=
HF_TOKEN=
PERSIST_DATASET=
FIRM_SIGNING_KEY_PEM=
AUTO_SYNC_ON_START=
VITE_API_BASE=
